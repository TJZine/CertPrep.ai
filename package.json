{
  "name": "certprep-ai",
  "version": "1.5.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "security-check": "bash scripts/check-secrets.sh --repo",
    "security-check:staged": "bash scripts/check-secrets.sh --staged",
    "test:security-check": "bash scripts/tests/check-secrets.test.sh",
    "prepare": "husky || true",
    "supabase:types": "supabase gen types typescript --project-id rkhtvyvuksuhzqlxjyzx > src/types/database.types.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@sentry/nextjs": "^10.71.0",
